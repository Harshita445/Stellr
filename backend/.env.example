# Constellation Backend — Environment Variables
# All values are defaults from app/core/config.py — override as needed.
# Copy this file to .env and fill in your values.

# Application
CONSTELLATION_ENVIRONMENT=development
CONSTELLATION_DEBUG=true

# Database
CONSTELLATION_DATABASE__URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/constellation

# Auth
CONSTELLATION_AUTH__JWT_SECRET=change-me-to-a-32-byte-string-in-prod
CONSTELLATION_AUTH__DEVICE_FINGERPRINT_SALT=change-me-too

# Frontend
CONSTELLATION_FRONTEND_URL=http://localhost:3000

# Redis (future)
# CONSTELLATION_REDIS__URL=redis://localhost:6379/0
