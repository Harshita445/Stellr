# ═══════════════════════════════════════════════════════════════════════
# Constellation — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# docker-compose reads .env automatically from the project root.
# ═══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=constellation

# ── Backend (prefixed with CONSTELLATION_) ────────────────────────────
CONSTELLATION_ENVIRONMENT=production

# JWT signing key (generate: openssl rand -hex 32)
CONSTELLATION_AUTH__JWT_SECRET=change-me-to-a-random-64-hex-string

# Salt for device fingerprint hashing (generate: openssl rand -hex 16)
CONSTELLATION_AUTH__DEVICE_FINGERPRINT_SALT=change-me-to-a-random-32-hex-string

# Public-facing URL of the app (no trailing slash)
CONSTELLATION_FRONTEND_URL=http://localhost
CONSTELLATION_CORS_ORIGINS=http://localhost

# ── Frontend ──────────────────────────────────────────────────────────
# API base URL as seen by the browser (same-origin via nginx)
NEXT_PUBLIC_API_URL=/api/v1
